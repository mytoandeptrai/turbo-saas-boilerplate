generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum LoginStatus {
  success
  failed

  @@map("login_status")
}

model User {
  id              String    @id
  name            String
  email           String
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  role            UserRole  @default(USER)
  banned          Boolean?  @default(false)
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires") @db.Timestamp(6)
  username        String    @default("")
  displayUsername String    @default("") @map("display_username")
  displayName     String?   @map("display_name") @db.VarChar(50)
  bio             String?   @db.VarChar(500)
  preferences     Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts  Account[]
  sessions  Session[]
  loginLogs LoginLog[]
  invoices  Invoice[]

  @@unique([email], map: "users_email_idx")
  @@unique([username], map: "users_username_idx")
  @@map("users")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "accounts_provider_account_idx")
  @@index([userId], map: "accounts_userId_idx")
  @@map("accounts")
}

model Session {
  id             String   @id
  userId         String   @map("user_id")
  token          String
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  impersonatedBy String?  @map("impersonated_by")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token], map: "sessions_token_idx")
  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}

model LoginLog {
  id         String      @id
  userId     String?     @map("user_id")
  email      String
  status     LoginStatus
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  failReason String?     @map("fail_reason")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "login_logs_user_id_idx")
  @@index([createdAt], map: "login_logs_created_at_idx")
  @@map("login_logs")
}

model Todo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("todos")
}

model Article {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  content      String
  slug         String                  @unique
  status       String                  @default("draft")
  tags         Json                    @default("[]")
  category     String                  @default("other")
  author       String                  @default("")
  viewCount    Int                     @default(0) @map("view_count")
  isPinned     Boolean                 @default(false) @map("is_pinned")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt  DateTime?               @map("published_at") @db.Timestamptz(6)
  /// Full-text search vector; maintained via raw SQL on write
  searchVector Unsupported("tsvector") @default(dbgenerated("''::tsvector")) @map("search_vector")

  @@index([slug], map: "articles_slug_idx")
  @@index([status], map: "articles_status_idx")
  @@map("articles")
}

model Order {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id")
  status      String   @default("pending_payment")
  items       Json     @default("[]")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  currency    String   @default("CNY") @db.VarChar(3)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "orders_user_id_idx")
  @@index([status], map: "orders_status_idx")
  @@map("orders")
}

model Job {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String
  status    String   @default("pending")
  payload   Json     @default("{}")
  result    Json?
  error     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status], map: "jobs_status_idx")
  @@index([type], map: "jobs_type_idx")
  @@map("jobs")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action       String
  actorId      String?   @map("actor_id")
  actorEmail   String?   @map("actor_email")
  actorName    String?   @map("actor_name")
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  before       Json?
  after        Json?
  detail       Json?
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  requestId    String?   @map("request_id")
  occurredAt   DateTime? @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId], map: "audit_logs_actor_id_idx")
  @@index([action], map: "audit_logs_action_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@index([occurredAt], map: "audit_logs_occurred_at_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

enum InvoiceStatus {
  VALID // đối soát khớp
  MISMATCH // lệch tiền, vẫn lưu để người dùng xử lý

  @@map("invoice_status")
}

enum InvoiceProvider {
  TCT
  VNPT
  MISA
  VIETTEL
  FPT

  @@map("invoice_provider")
}

enum InvoiceItemKind {
  GOODS
  PROMOTION
  DISCOUNT
  NOTE

  @@map("invoice_item_kind")
}

model Invoice {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String          @map("owner_id")
  provider         InvoiceProvider
  status           InvoiceStatus
  invoiceTemplate  String          @map("invoice_template") @db.VarChar(20) // KHMSHDon
  invoiceSeries    String          @map("invoice_series") @db.VarChar(20) // KHHDon
  invoiceNumber    String          @map("invoice_number") @db.VarChar(20) // SHDon
  issuedAt         DateTime        @map("issued_at") @db.Date // NLap
  currency         String          @default("VND") @db.VarChar(3)
  exchangeRate     Decimal         @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  sellerTaxCode    String          @map("seller_tax_code") @db.VarChar(14)
  sellerName       String          @map("seller_name")
  sellerAddress    String?         @map("seller_address")
  buyerTaxCode     String?         @map("buyer_tax_code") @db.VarChar(14)
  buyerName        String?         @map("buyer_name")
  buyerAddress     String?         @map("buyer_address")
  subtotalAmount   Decimal         @map("subtotal_amount") @db.Decimal(18, 2) // TgTCThue
  vatAmount        Decimal         @map("vat_amount") @db.Decimal(18, 2) // TgTThue
  totalAmount      Decimal         @map("total_amount") @db.Decimal(18, 2) // TgTTTBSo
  validationIssues Json            @default("[]") @map("validation_issues")
  sourceFileName   String          @map("source_file_name")
  sourceFileHash   String          @map("source_file_hash") @db.Char(64) // SHA-256
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items InvoiceItem[]

  @@unique([sellerTaxCode, invoiceTemplate, invoiceSeries, invoiceNumber], map: "invoices_identity_idx")
  @@index([ownerId, issuedAt], map: "invoices_owner_issued_at_idx")
  @@index([ownerId, status], map: "invoices_owner_status_idx")
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  kind            InvoiceItemKind @default(GOODS)
  lineNumber     Int     @map("line_number") // STT
  code           String? @db.VarChar(50) // MHHDVu
  name           String // THHDVu
  unit           String? @db.VarChar(50) // DVTinh
  quantity       Decimal?@db.Decimal(18, 6) // SLuong
  unitPrice      Decimal?@map("unit_price") @db.Decimal(18, 6) // DGia
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2) // STCKhau
  amount         Decimal @db.Decimal(18, 2) // ThTien
  vatRate        String? @map("vat_rate") @db.VarChar(10) // TSuat: "10%", "KCT", "KKKNT"…
  vatAmount      Decimal?@map("vat_amount") @db.Decimal(18, 2) // TThue

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "invoice_items_invoice_id_idx")
  @@map("invoice_items")
}
